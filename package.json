{
  "name": "earth-online",
  "private": true,
  "version": "0.1.0",
  "description": "Earth Online 2.0 - an RPG-style weekly life tracker with a ChatGPT Game Master",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "save": "bash scripts/auto-commit.sh",
    "smoke": "node scripts/smoke.mjs",
    "nightly": "node scripts/nightly.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
